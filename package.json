{
  "name": "nef",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "cssWatch": "sass --watch src/scss/:dist/css/",
    "contactWatch": "sass --watch src/scss/contact:dist/css/contact --quiet-deps",
    "projectsWatch": "sass --watch src/scss/projects:dist/css/projects --quiet-deps",
    "fluxscape": "sass --watch src/scss/fluxscape:dist/css/fluxscape --quiet-deps",
    "site-vision": "sass --watch src/scss/site-vision:dist/css/site-vision --quiet-deps",
    "monitor": "nodemon app.js",
    "dev": "run-p cssWatch monitor",
    "start": "node app.js",
    "buildA": "./buildAll.sh",
    "buildC": "./buildCode.sh",
    "update": "ncu --interactive --format group"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "date-and-time": "^4.4.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "fs": "^0.0.1-security",
    "morgan": "^1.10.1",
    "multiparty": "^4.2.3",
    "nodemailer": "^8.0.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "sass": "^1.99.0"
  }
}
